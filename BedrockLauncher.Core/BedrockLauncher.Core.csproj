<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PublishTrimmed>false</PublishTrimmed>
    <Title>BedrockLauncher.Core</Title>
    <Authors>Round Studio</Authors>
    <Company>Round Studio</Company>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Product>BedrockLauncher.Core</Product>
    <Description>Minecraft Bedrock Installer and Launcher</Description>
    <Copyright>Minecraft for Microsoft and Mojang Studio</Copyright>
    <RepositoryUrl>https://github.com/Round-Studio/BedrockLauncher.Core</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Round-Studio/BedrockLauncher.Core</PackageProjectUrl>
    <PackageLicenseUrl>https://mit-license.org/</PackageLicenseUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Version>2.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Version>2.0.0</Version>
  </PropertyGroup>
	
  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::Now.ToString(yyMMddHHmm))</BuildTimestamp>
  </PropertyGroup>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="dotnet fsi BuildChain/BuilderBefore.fsx" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="dotnet fsi BuildChain/BuilderAfter.fsx" />
  </Target>

</Project>

